{
  "name": "@finni/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "knex": "tsx ../node_modules/knex/bin/cli.js",
    "db:migrate": "npm run knex -- migrate:latest",
    "db:seed": "npm run knex -- seed:run",
    "db:reset": "tsx src/db/resetPatients.ts"
  },
  "dependencies": {
    "@finni/shared": "*",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
